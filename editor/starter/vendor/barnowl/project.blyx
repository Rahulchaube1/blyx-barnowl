use std::cli;
use console;
use barnowl;

fn main() {
    let argv = cli_args();
    let count = args_len(argv);
    if count == 1 && args_at(argv, 0) == "--help" {
        println!("Inspect a supplied audit export for sequence gaps, replays and clock reversals.");
        println!("Usage: barnowl ids times");
        println!("Vector arguments are comma-separated; use [] for an empty vector.");
        return;
    }
    let mut result = [];
    if count == 0 {
        result = barnowl_audit([40, 42, 42], [10, 14, 12]);
    } else {
        if count != 2 { stderr_line("Wrong argument count. Use --help."); process_exit(2); }
        let ids = console_vector(args_at(argv, 0));
        let times = console_vector(args_at(argv, 1));
        result = barnowl_audit(ids, times);
    }
    if len(result) == 0 { stderr_line("Invalid input for Barnowl. See the package input contract."); process_exit(1); }
    let mut i = 0;
    while i < len(result) {
        println!(at(result, i));
        i += 1;
    }
}
